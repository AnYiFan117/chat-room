# Vite 环境变量示例，复制为 .env 并替换为实际服务信息

# WebSocket 消息中转端点。代码会自动追加 ?room=ROOM_ID。
# 本地开发指向本地中转服务（注意本地用 ws，线上用 wss）：
#   VITE_SIGNALING_ENDPOINT=ws://localhost:23333/signal
# 线上示例：
VITE_SIGNALING_ENDPOINT=wss://your-service.example/signal

# 【已废弃】旧 WebRTC P2P 架构的 ICE/TURN 配置。
# 当前 WebSocket 中转架构不再使用，保留仅为向后兼容，可删除。
# VITE_ICE_SERVERS=[{"urls":"stun:your-stun.example:3478"}]
